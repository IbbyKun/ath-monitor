# ============================================================================
# EmpMonitor — docker compose configuration
#
#   cp .env.docker.example .env      then edit the values below
#
# Generate the four secrets with:
#   openssl rand -hex 32
# CRYPTO_PASSWORD must be exactly 32 characters — it is used directly as an
# AES-256 key, so a 16-byte hex string is required, not 32 bytes.
# ============================================================================

# ── Public entrypoint ───────────────────────────────────────────────────────
HTTP_PORT=8090

# ── Datastores ──────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_DATABASE=emp_local_db
MYSQL_PORT=3307
MONGO_PORT=27018
REDIS_PORT=6380

# ── Shared secrets (MUST be identical across every service) ─────────────────
# openssl rand -hex 16   -> 32 characters, required for AES-256
CRYPTO_PASSWORD=00000000000000000000000000000000
# The frontend derives its IV from the first 16 chars of CRYPTO_PASSWORD.
VITE_PASSWORD_IV=0000000000000000
# openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=change_me_access_token_secret
JWT_REFRESH_TOKEN_SECRET=change_me_refresh_token_secret
JWT_SECRET=change_me_jwt_secret
SESSION_SECRET=change_me_session_secret
SECRET_KEY=change_me_secret_key

# ── Object storage (S3-compatible; MinIO by default) ────────────────────────
# There is no Azure Blob driver in this codebase. Use MinIO, or point the S3
# driver at real AWS S3 from Settings > Storage Types.
MINIO_ROOT_USER=empmonitor
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=empmonitor-screenshots
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Schema loader ───────────────────────────────────────────────────────────
# true DROPS and recreates the database. Only ever set true on a fresh install.
FRESH_DB=false

# ── Local admin login bypass ────────────────────────────────────────────────
# Skips the EmpCloud SSO dependency so you can log in on a standalone stack.
# Any email + this password logs in as the org described in ADMIN_DETAILS.
# LEAVE THESE BLANK IN PRODUCTION.
AUTH_METHOD_V3=true
ADMIN_PASSWORD=change_me_admin_password
ADMIN_DETAILS={"name":"Demo Admin","first_name":"Demo","last_name":"Admin","email":"admin@example.com","username":"demo","address":"","phone":"","product_id":99,"begin_date":"2026-01-01","expire_date":"2031-01-01","timezone":"Asia/Karachi","total_allowed_user_count":50,"region":1,"is_on_prem":"true","is_blocked":"false"}

# ── Optional third-party keys (features degrade gracefully without them) ────
# Email: password resets, 2FA codes, scheduled reports
SENDGRID_API_KEY=
SMTP_URL=
EMP_ADMIN_EMAIL=
# SMS: late-login alerts. Dummy values satisfy the Twilio SDK constructor,
# which runs at require-time even when SMS is switched off.
TWILIO_ACCOUNT_SID=ACdummy0000000000000000000000000
TWILIO_AUTH_TOKEN=dummy_auth_token
# Cron expression for temp report-file cleanup (read unconditionally at boot)
REPORT_CRON=0 * * * *
# Message queue for desktop-agent activity ingestion
RABBITMQ_URL=

TIMEZONE=Africa/Abidjan
